{
  "id": "coding",
  "counters": {
    "rework": { "max": 2 },
    "llm-calls": { "max": 40 }
  },
  "limits": {
    "wallClockMs": 7200000
  },
  "outcome": {
    "when": { "ns": "verify", "path": ["allPassed"], "equals": true },
    "then": "completed",
    "otherwise": "blocked",
    "otherwiseReason": "验证未通过，且返工预算（rework）已耗尽或没有可换的执行者。"
  },
  "nodes": [
    {
      "id": "repo-scan",
      "type": "source",
      "plugin": "source-repo",
      "params": { "maxTreeEntries": 120, "maxReadmeLines": 120 },
      "outputs": ["repo"],
      "onError": "fallback"
    },
    {
      "id": "wiki-recall",
      "type": "source",
      "plugin": "source-wiki",
      "outputs": ["wiki"],
      "onError": "fallback"
    },
    {
      "id": "plan",
      "type": "decision",
      "plugin": "plan",
      "params": { "provider": "glm" },
      "inputs": ["repo", "wiki"],
      "outputs": ["plan"]
    },
    {
      "id": "route",
      "type": "decision",
      "plugin": "router",
      "params": { "provider": "glm" },
      "inputs": ["plan"],
      "reads": ["verify", "execution", "repo"],
      "outputs": ["assignments"],
      "retries": 1
    },
    {
      "id": "execute",
      "type": "action",
      "plugin": "coder",
      "inputs": ["assignments"],
      "reads": ["plan", "repo", "verify"],
      "outputs": ["execution"]
    },
    {
      "id": "verify",
      "type": "action",
      "plugin": "verifier",
      "inputs": ["execution"],
      "outputs": ["verify"]
    },
    {
      "id": "capture",
      "type": "sink",
      "plugin": "sink-capture",
      "inputs": ["plan", "execution", "verify"],
      "outputs": ["capture"]
    },
    {
      "id": "report",
      "type": "sink",
      "plugin": "sink-report",
      "inputs": ["verify"],
      "reads": ["plan", "execution", "assignments"],
      "outputs": ["report"]
    }
  ],
  "edges": [
    { "from": "repo-scan", "to": "plan" },
    { "from": "wiki-recall", "to": "plan" },
    { "from": "plan", "to": "route" },
    { "from": "route", "to": "execute" },
    { "from": "execute", "to": "verify" },
    { "from": "verify", "to": "capture" },
    { "from": "verify", "to": "report" },
    { "from": "verify", "to": "route", "backedge": true, "guard": { "counter": "rework", "max": 2, "when": { "ns": "verify", "path": ["allPassed"], "equals": false } } }
  ]
}
