menu "Yahamic"

    config YAHAMIC_SELFTEST
        bool "开机自检:采集 1 秒并打印响度"
        default n
        help
            台架调试用:开机采集 1 秒,在日志里打印 RMS 与削波情况,
            不连 Mac 也能确认麦克风链路是好的。

    choice YAHAMIC_SPECTRUM_STYLE
        prompt "讲话时的屏幕动效"
        default YAHAMIC_SPECTRUM_WAVES
        help
            正弦声波:三条流动的正弦曲线随音量起伏,音高(频谱重心)
            连续驱动流速与疏密(语音助手式);
            频谱柱:32 根圆角色条按频带跳动(播放器式)。

        config YAHAMIC_SPECTRUM_WAVES
            bool "正弦声波(流动曲线)"
        config YAHAMIC_SPECTRUM_BARS
            bool "频谱柱(圆角色条)"
    endchoice

endmenu
